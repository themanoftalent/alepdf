<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ai.storyteller.pdfcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>AlePdf</name>
  <summary>Read, edit, organize, combine, split and secure PDFs</summary>
  <developer id="com.themanoftalent">
    <name>TheManOfTalent</name>
  </developer>
  <description>
    <p>
      AlePdf is a modern, fast, private PDF editor and workbench built in pure Rust.
      Read, comment on, edit text and images, fill and sign forms, organize pages, and protect documents.
    </p>
  </description>
  <launchable type="desktop-id">ai.storyteller.pdfcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.pdfcraft</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://alepdf-website.vercel.app/</url>
  <url type="bugtracker">https://github.com/themanoftalent/alepdf/issues</url>
  <url type="help">https://alepdf-website.vercel.app/</url>
  <url type="contact">https://alepdf-website.vercel.app/</url>
  <categories>
    <category>Office</category>
    <category>Viewer</category>
  </categories>
  <keywords>
    <keyword>pdf</keyword>
    <keyword>viewer</keyword>
    <keyword>annotate</keyword>
    <keyword>forms</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>A PDF open with its threaded comments</caption>
      <image>https://raw.githubusercontent.com/storytold/pdfcraft/main/docs/images/pdfcraft-viewer.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>pdfcraft</binary>
    <mediatype>application/pdf</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
